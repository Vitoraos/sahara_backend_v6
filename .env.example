APP_NAME=Sahara Triage Voice Agent API
ENVIRONMENT=development
API_PREFIX=/api

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BASE_URL=
ALLOW_DEV_UNAUTHENTICATED=false
AFRICAS_TALKING_VOICE_NUMBER=
ESCALATION_PHONE_NUMBER=
PHONE_RECORD_MAX_SECONDS=60
REDIS_URL=rediss://default:<TOKEN>@<host>:6379/0
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

SAHARA_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_EXTRACTION_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_RESPONSE_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SUMMARY_MODEL=meta-llama/llama-3.3-70b-instruct
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_WEBHOOK_SECRET=
# NOTE: this TTS block is very detailed (chunk polling, voice params) —
# confirm it came from a real Sahara TTS docs page before trusting it in
# production; it has not been independently verified against public docs.
# Single Intron key — shared by STT and TTS.
INTRON_API_KEY=
INTRON_TTS_ENDPOINT=wss://infer.voice.intron.io/tts/v1/stream
# Default TTS accent (used for English sessions and as fallback when the
# detected language has no mapped accent). The per-session voice is dynamic:
# signup preferred_language -> auto-switch with lock -> accent auto-mapped.
# Gender is required by Intron and is deployment-wide (no per-user gender).
INTRON_TTS_VOICE_ACCENT=
INTRON_TTS_VOICE_GENDER=
# Fallback default TTS language when no session language applies. Browser
# sessions always override it. (STT fallback lives with the STT block below.)
INTRON_TTS_LANGUAGE=en
INTRON_TTS_OUTPUT_AUDIO_FORMAT=wav
INTRON_TTS_SAMPLE_RATE=48000
INTRON_TTS_TEXT_CHUNK_CHARS=100
# Session voice: patient preferred_language (signup) drives STT input and the
# opening TTS voice; INTRON_TTS_VOICE_ACCENT is the fallback/default (and the
# English accent). First confident detection auto-switches + locks the voice.
VOICE_LOCK_CONFIDENCE=0.6

# Comma-separated configured clinical field names and English danger phrases.
# Candidate community-health configuration; clinically review before production.
REQUIRED_TRIAGE_FIELDS=patient_age,sex,chief_complaint,symptoms,symptom_onset,symptom_severity,breathing_difficulty,consciousness_status,seizure_or_convulsion,ability_to_drink,bleeding
DANGER_SIGN_PHRASES=unconscious,not conscious,cannot wake up,can't wake up,won't wake up,does not respond,not responding,passed out and won't wake up,cannot breathe,can't breathe,struggling to breathe,severe difficulty breathing,severe trouble breathing,gasping for air,gasping,choking and cannot breathe,breathing is extremely difficult,severe chest pain,crushing chest pain,pressure in my chest,heavy pressure in my chest,chest pain with difficulty breathing,chest pain and sweating,chest pain and fainting,face is drooping,one side of the face is weak,one arm is weak,one side of the body is weak,sudden weakness on one side,suddenly cannot speak,speech suddenly became unclear,sudden loss of vision,sudden severe dizziness with weakness,having a seizure,having a convulsion,convulsing,fitting,having fits,had a seizure,had a convulsion,uncontrolled shaking,bleeding heavily,heavy bleeding,bleeding won't stop,bleeding cannot stop,cannot stop the bleeding,blood is coming out heavily,vomiting a lot of blood,coughing up a lot of blood,passing a lot of blood,throat is closing,throat is swelling,tongue is swelling,face is swelling and cannot breathe,suddenly cannot breathe after taking medicine,severe allergic reaction,cannot drink,unable to drink,cannot keep any fluids down,vomits everything,has not been able to drink,very weak and unable to drink,suddenly confused,does not know where they are,acting strangely and not responding normally,extremely confused,suddenly became confused,severe injury,serious injury,major accident,severe head injury,unconscious after an accident,heavy bleeding after an accident,unable to breastfeed,chest indrawing,severe dehydration,swelling of both feet,severe malnutrition
PERSISTENCE_TIMEOUT_SECONDS=5

EXTERNAL_TIMEOUT_SECONDS=10
EXTERNAL_MAX_RETRIES=2

INTRON_STT_ENDPOINT=wss://infer.voice.intron.io/stt/v1/stream
INTRON_STT_LANGUAGE=en
INTRON_STT_SAMPLE_RATE=16000
INTRON_STT_BIT_RATE=16
INTRON_STT_CHANNELS=1
